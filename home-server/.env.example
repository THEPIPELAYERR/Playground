# Copy to .env and replace every value. Never commit .env (it's in .gitignore).
# Make random values with:  openssl rand -hex 24
# FIREFLY_APP_KEY must be exactly 32 characters:  openssl rand -hex 16
FIREFLY_APP_KEY=replace-with-32-characters-xxxxx
FIREFLY_DB_PASSWORD=replace-me
GHOSTFOLIO_DB_PASSWORD=replace-me
GHOSTFOLIO_REDIS_PASSWORD=replace-me
GHOSTFOLIO_ACCESS_TOKEN_SALT=replace-me
GHOSTFOLIO_JWT_SECRET_KEY=replace-me
