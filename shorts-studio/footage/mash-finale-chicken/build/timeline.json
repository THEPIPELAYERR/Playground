 "scenes": [
  {
   "scene": "hook",
   "t0": 0.35,
   "t1": 3.83,
   "text": "The M*A*S*H finale has a chicken in it."
  },
  {
   "scene": "hook2",
   "t0": 4.11,
   "t1": 5.91,
   "text": "It was never a chicken."
  },
  {
   "scene": "date",
   "t0": 6.19,
   "t1": 13.03,
   "text": "Goodbye, Farewell and Amen aired February 28th, 1983, on CBS."
  },
  {
   "scene": "viewers",
   "t0": 13.31,
   "t1": 18.87,
   "text": "About 106 million US viewers. Still the most-watched scripted episode."
  },
  {
   "scene": "hospital",
   "t0": 19.15,
   "t1": 21.83,
   "text": "Hawkeye is in a psychiatric hospital."
  },
  {
   "scene": "bus",
   "t0": 22.11,
   "t1": 24.71,
   "text": "Then a bus, and an enemy patrol."
  },
  {
   "scene": "quiet",
   "t0": 24.99,
   "t1": 28.15,
   "text": "Hawkeye tells the woman to keep her chicken quiet."
  },
  {
   "scene": "baby",
   "t0": 28.43,
   "t1": 29.91,
   "text": "It was her baby."
  },
  {
   "scene": "word",
   "t0": 30.19,
   "t1": 34.31,
   "text": "He buried that memory under one word: chicken."
  },
  {
   "scene": "armistice",
   "t0": 34.59,
   "t1": 37.11,
   "text": "The armistice ends the war."
  },
  {
   "scene": "mozart",
   "t0": 37.39,
   "t1": 41.91,
   "text": "Winchester teaches Chinese POW musicians Mozart."
  },
  {
   "scene": "music",
   "t0": 42.19,
   "t1": 47.43,
   "text": "Later, most of them are killed, and music pains him."
  },
  {
   "scene": "klinger",
   "t0": 47.71,
   "t1": 53.91,
   "text": "Klinger, who spent years trying to get home, marries Soon-Lee and stays in Korea."
  },
  {
   "scene": "bj",
   "t0": 54.19,
   "t1": 57.03,
   "text": "BJ can't say goodbye out loud."
  },
  {
   "scene": "stones",
   "t0": 57.31,
   "t1": 63.59,
   "text": "As Hawkeye's helicopter lifts off, he sees GOODBYE spelled in stones."
  },
  {
   "scene": "end",
   "t0": 63.87,
   "t1": 67.99,
   "text": "I've never heard the word chicken the same way since."
  }
 ],
